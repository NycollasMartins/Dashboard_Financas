# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ---------------------------------------------------------------------------

# URL pública do app (links de e-mail, convites, botões do Telegram). Produção: https://larmais.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
# Local: rode `supabase status` e use API_URL / PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SEGREDO (só servidor): webhook do Telegram e disparo de notificações (Fase 6).
# Local: `supabase status` → SECRET_KEY. Nunca use prefixo NEXT_PUBLIC_ em segredos.
SUPABASE_SECRET_KEY=

# --- Fase 5 · Assistente (IA opcional: sem chaves, funciona só com o parser local) ---
# SEGREDOS (só servidor). Passo a passo para obter: docs/setup-manual.md, seção E.
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelos (opcional). Padrões: gemini-3.1-flash-lite e openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# Limites (opcional): chamadas de IA por usuário/dia/provedor, por minuto e valor que exige confirmação (centavos)
# ASSISTANT_AI_DAILY_LIMIT=40
# ASSISTANT_AI_PER_MINUTE=8
# ASSISTANT_CONFIRM_ABOVE_CENTS=100000
# ASSISTANT_AI_ENABLED=true

# --- Fase 6 · Fotos e áudio no assistente (opcional; padrões abaixo) ---
# GROQ_AUDIO_MODEL=whisper-large-v3
# ASSISTANT_PHOTO_DAILY_LIMIT=15
# ASSISTANT_AUDIO_DAILY_LIMIT=30
# ASSISTANT_MAX_AUDIO_SECONDS=60
# true = todo lançamento por ÁUDIO pede confirmação (padrão false: mesmas regras do texto)
# ASSISTANT_CONFIRM_AUDIO=false

# --- Fase 6 · Telegram (@LarMaisBot) — passo a passo: docs/setup-manual.md §F ---
# SEGREDOS. O token vem do @BotFather; NUNCA cole o token em chat/issue/commit.
TELEGRAM_BOT_TOKEN=
# Gere com: openssl rand -hex 32  (o Telegram manda de volta no header de cada webhook)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=LarMaisBot
# Só para testar localmente com Cloudflare Tunnel (https://<algo>.trycloudflare.com)
# TELEGRAM_WEBHOOK_URL=

# --- Fase 6 · Notificações ---
# Gere com: pnpm vapid   (a pública também é build arg do Docker)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@larmais.tech
# Segredo do pg_cron → /api/notifications/dispatch (o MESMO valor vai no Vault: larmais_cron_secret)
# Gere com: openssl rand -hex 32
CRON_SECRET=
