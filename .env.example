# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ---------------------------------------------------------------------------

# URL pública do app (usada nos links de e-mail e convites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
# Local: rode `supabase status` e use API_URL / PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SEGREDO (só servidor). Usado a partir da Fase 6 pelo webhook do bot.
# Nunca use prefixo NEXT_PUBLIC_ em segredos.
SUPABASE_SECRET_KEY=

# --- Fase 5 · Assistente (IA opcional: sem chaves, funciona só com o parser local) ---
# SEGREDOS (só servidor). Passo a passo para obter: docs/setup-manual.md, seção E.
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelos (opcional). Padrões: gemini-3.1-flash-lite e openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# Limites (opcional): chamadas de IA por usuário/dia/provedor, por minuto e valor que exige confirmação (centavos)
# ASSISTANT_AI_DAILY_LIMIT=40
# ASSISTANT_AI_PER_MINUTE=8
# ASSISTANT_CONFIRM_ABOVE_CENTS=100000
# ASSISTANT_AI_ENABLED=true

# --- Fases futuras (deixe vazio por enquanto) ---
# Fase 6 · WhatsApp Cloud API
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Fase 6 · Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
