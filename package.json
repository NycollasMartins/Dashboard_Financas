{
  "name": "dashboard-financas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,storage-api,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db",
    "dev:lan": "node scripts/dev-lan.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test --project=setup --project=\"Desktop Chrome\" --project=\"Mobile Safari (iPhone 15)\" --project=\"Mobile Safari (iPhone SE)\" --project=\"Mobile Chrome (Android 360x800)\"",
    "test:e2e:ios": "playwright test --project=setup --project=\"Mobile Safari (iPhone 15)\" --project=\"Mobile Safari (iPhone SE)\"",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}
